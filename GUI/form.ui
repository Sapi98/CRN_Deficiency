  <property name="styleSheet">
   <string>
QWidget { font-family: 'Segoe UI', 'Helvetica Neue', sans-serif; font-size: 14px;
          color: #22334a; background: #f4f6fa; }
QFrame#header, QFrame#inputCard, QFrame#guideCard, QFrame#resultsCard { background: white; border: 1px solid #e0e6ef; border-radius: 12px; }
QFrame#header { border-radius: 0; border: none; border-bottom: 1px solid #e0e6ef; }
QWidget#textPage, QWidget#uploadPage { background: white; }
QLabel { background: transparent; }
QLabel#brandLabel { font-size: 19px; font-weight: 700; }
QLabel#titleLabel { font-size: 29px; font-weight: 700; }
QLabel#subtitle, QLabel#unusedMuted { color: #69788d; }
QLabel#unusedSection { font-size: 17px; font-weight: 600; }
QLabel#previewBadge { color: #397d74; background: #eaf5f1; border-radius: 10px; padding: 6px 12px; }
QLabel#uploadSymbol { color: #246dce; background: #edf4ff; border-radius: 12px; font-size: 25px; padding: 10px; }
QPushButton { background: white; border: 1px solid #d6deea; border-radius: 7px; padding: 9px 16px; font-weight: 600; }
QPushButton:hover { background: #edf4ff; border-color: #a6c4ef; }
QPushButton:pressed { background: #deebff; }
QPushButton#analyzeButton { background: #246dce; color: white; border: none; }
QPushButton#analyzeButton:disabled { background: #e9edf3; color: #8b97a7; }
QPushButton#analyzeButton:hover { background: #1b5ab0; }
QPushButton:disabled { background: #e9edf3; color: #8b97a7; border-color: #e1e6ee; }
QPushButton:focus, QComboBox:focus { border: 2px solid #246dce; }
QTabWidget::pane { background: white; border: none; }
QTabBar::tab { background: white; color: #718097; padding: 12px 20px; border-bottom: 2px solid #e5eaf1; }
QTabBar::tab:selected { color: #246dce; border-bottom: 2px solid #246dce; font-weight: 600; }
QPlainTextEdit { font-family: 'Menlo', 'Consolas', monospace; background: #fafbfd; border: 1px solid #dfe6f0; border-radius: 8px; padding: 12px; selection-background-color: #c6ddff; }
QPlainTextEdit:focus { border: 1px solid #246dce; }
QComboBox { background: white; border: 1px solid #d6deea; border-radius: 6px; padding: 7px 12px; min-width: 145px; }
QComboBox QAbstractItemView { background: white; selection-background-color: #deebff; }
QFrame#dropZone { background: #fafcff; border: 2px dashed #bccce2; border-radius: 12px; }
QFrame#dropZone[active=&quot;true&quot;] { background: #edf4ff; border-color: #246dce; }
QScrollArea { border: none; }

QLabel[role=&quot;muted&quot;] { color: #69788d; }
QLabel[role=&quot;section&quot;] { font-size: 17px; font-weight: 600; }
QLabel#taglineLabel, QLabel#formatLabel, QLabel#editorHint, QLabel#characterCount, QLabel#dropHint, QLabel#supportedFormats, QLabel#fileLabel, QLabel#analysisHint, QLabel#reactionHelp, QLabel#odeHelp, QLabel#fileHelp, QLabel#resultsMetrics, QLabel#resultsHint, QLabel#statusLabel { color: #69788d; }
QLabel#inputHeading, QLabel#dropHeading, QLabel#guideHeading, QLabel#reactionHeading, QLabel#odeHeading, QLabel#fileHeading, QLabel#resultsHeading, QLabel#resultsEmptyTitle { font-size: 17px; font-weight: 600; }
QLabel#subtitleLabel { color: #69788d; }</string>
